# ========================================
# Datewizza – .gitignore
# ========================================

# --- OS / IDE ---
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.iml

# --- Node.js / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# --- Build output ---
dist/
build/
*.min.js
*.min.css
*.bundle.js
*.chunk.js
*.chunk.css

# --- Environment / Secrets ---
.env
.env.local
.env.*.local
*.key
*.pem
*.crt

# --- Cloudflare Workers ---
wrangler.toml
.dev.vars
.workerd/
*.worker.js.map
*.worker.js

# --- Local storage / data ---
*.localstorage
*.sqlite
*.sqlite-journal
*.db
*.db-journal

# --- Logs ---
logs/
*.log

# --- Temporary files ---
.tmp/
tmp/
*.tmp
.cache/

# --- Editor specific ---
*.sublime-*
*.swp

# --- Coverage / Test ---
coverage/
.nyc_output/

# --- PWA build artefacts (if you generate them) ---
workbox-*.js
sw.js  # only if generated; commit if manually written

# --- Misc ---
*.bak
*.orig
*.rej