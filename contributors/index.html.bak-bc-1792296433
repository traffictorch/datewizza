<section class="max-w-3xl mx-auto my-16 px-4">
  <div class="bg-white dark:bg-gray-900 rounded-3xl p-8 border border-gray-200 dark:border-gray-700 shadow-xl">
    <h2 class="text-2xl md:text-3xl font-black text-center mb-2 bg-gradient-to-r from-orange-500 to-pink-600 bg-clip-text text-transparent">
      Submit a Contribution
    </h2>
    <p class="text-center text-gray-600 dark:text-gray-400 mb-6 text-sm">
      Found a bug, have a feature request, or want to share real-world data? Let us know. Contributions earn +25 points. High value submissions are considered for a custom widget in Tool Contributions. Plus additional +50 points.
    </p>
    
    <form id="contribution-form" class="space-y-4">
      <!-- Name/Handle -->
      <div>
        <label class="block text-sm font-semibold mb-1 text-gray-700 dark:text-gray-300">Your Name / Username</label>
        <input type="text" id="contrib-name" required maxlength="100" placeholder="e.g., JohnDoe or @johndoe" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-black/50 focus:ring-2 focus:ring-orange-500 outline-none">
      </div>

      <!-- Email -->
      <div>
        <label class="block text-sm font-semibold mb-1 text-gray-700 dark:text-gray-300">Email Address</label>
        <input type="email" id="contrib-email" required maxlength="150" placeholder="you@example.com" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-black/50 focus:ring-2 focus:ring-orange-500 outline-none">
      </div>

      <!-- Tool Name -->
      <div>
        <label class="block text-sm font-semibold mb-1 text-gray-700 dark:text-gray-300">Which tool is this regarding?</label>
<select id="contrib-tool" required>
  <option value="">Select a tool...</option>
  <option value="nusa">NUSA (Homepage)</option>
  <option value="ofux-tool">OFUX Tool</option>
  <option value="lighthouse-plus-tool">Lighthouse Plus</option>
  <option value="topical-authority-audit-tool">Topical Authority</option>
  <option value="seo-entity-extractor-tool">SEO Entity Extractor</option>
  <option value="seo-ux-tool">SEO + UX Tool</option>
  <option value="schema-generator">Schema Generator</option>
  <option value="local-seo-tool">Local SEO Tool</option>
  <option value="seo-intent-tool">SEO Intent Tool</option>
  <option value="product-seo-tool">Product SEO Tool</option>
  <option value="aeo-performance-tool">AEO Performance</option>
  <option value="ai-search-optimization-tool">AI Search Optimization</option>
  <option value="ai-voice-search-tool">AI Voice Search</option>
  <option value="ai-audit-tool">AI Audit Tool</option>
  <option value="quit-risk-tool">Quit Risk Tool</option>
  <option value="keyword-research-tool">Keyword Research</option>
  <option value="keyword-tool">Keyword Placement</option>
  <option value="keyword-vs-tool">Keyword VS Tool</option>
  <option value="other">Other / General Feedback</option>
</select>
      </div>

      <!-- Contribution Details (Increased to 6000) -->
      <div>
        <label class="block text-sm font-semibold mb-1 text-gray-700 dark:text-gray-300">Contribution Details</label>
        <textarea id="contrib-details" required maxlength="6000" rows="8" placeholder="Describe the bug, feature request, or feedback in detail (max 6000 characters)..." class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-black/50 focus:ring-2 focus:ring-orange-500 outline-none resize-y"></textarea>
        <p class="text-xs text-right text-gray-500 mt-1"><span id="char-count">0</span> / 6000</p>
      </div>

      <!-- Public toggle -->
      <div class="flex items-start gap-3 bg-blue-500/5 border border-blue-500/20 rounded-lg p-3">
        <input type="checkbox" id="contrib-public" checked class="mt-1 w-4 h-4 accent-orange-500 flex-shrink-0">
        <label for="contrib-public" class="text-sm text-gray-700 dark:text-gray-300 leading-snug cursor-pointer">
          <strong>Make this public</strong> — show it in the 🌐 Recent Contributions feed below. Visible to everyone, including your name, tool, and message. Uncheck to keep it private (only support sees it).
        </label>
      </div>

      <!-- Submit Button -->
      <button type="submit" id="contrib-submit-btn" class="w-full py-4 bg-gradient-to-r from-orange-500 to-pink-600 text-white font-bold rounded-xl hover:brightness-110 transition shadow-lg">
        Submit Contribution
      </button>
    </form>
    
    <!-- Status Message -->
    <p id="contrib-status" class="text-center text-sm mt-4 hidden"></p>
  </div>
</section>

