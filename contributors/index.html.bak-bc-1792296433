 <script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contribution-form');
    const textarea = document.getElementById('contrib-details');
    const charCount = document.getElementById('char-count');
    const statusEl = document.getElementById('contrib-status');
    const submitBtn = document.getElementById('contrib-submit-btn');

    // Update character count
    textarea.addEventListener('input', () => {
      charCount.textContent = textarea.value.length;
    });

    // Handle form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const token = localStorage.getItem('authToken');
      if (!token) {
        statusEl.textContent = '⚠️ You must be logged in to submit a contribution.';
        statusEl.className = 'text-center text-sm mt-4 text-red-500 font-bold';
        statusEl.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
      statusEl.classList.add('hidden');

      const payload = {
        type: 'feedback', // Default type for this form
        subject: document.getElementById('contrib-name').value.trim(),
        message: textarea.value.trim(),
        tool: document.getElementById('contrib-tool').value,
        page_url: window.location.href,
        // Send name and email so the backend can use them for the reply-to and email body
        name: document.getElementById('contrib-name').value.trim(),
        email: document.getElementById('contrib-email').value.trim(),
        public: document.getElementById('contrib-public').checked ? 1 : 0
      };

      try {
        const WORKER_URL = 'https://traffic-torch-auth.traffictorch.workers.dev';
        const res = await fetch(`${WORKER_URL}/api/contributions`, {
          method: 'POST',
          headers: { 
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + token
          },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          statusEl.textContent = '✓ Contribution submitted successfully! We will review it shortly.';
          statusEl.className = 'text-center text-sm mt-4 text-green-500 font-bold';
          form.reset();
          charCount.textContent = '0';
          // Reload the public feed so the new contribution appears
          try { window.dispatchEvent(new Event('tt:contrib-submitted')); } catch (e) {}
        } else {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error || 'Server responded with an error');
        }
      } catch (err) {
        statusEl.textContent = '⚠️ ' + (err.message || 'Failed to submit. Please try again or email us directly.');
        statusEl.className = 'text-center text-sm mt-4 text-red-500 font-bold';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Contribution';
        statusEl.classList.remove('hidden');
      }
    });
  });
</script>
  
<script>
(function () {
  const WORKER = 'https://traffic-torch-auth.traffictorch.workers.dev';
  const listEl = document.getElementById('recent-contributions-list');
  const moreBtn = document.getElementById('recent-contrib-load-more');
  if (!listEl) return;

  const TYPE = {
    bug:      { icon: '🐛', label: 'Bug',      cls: 'bg-red-500/10 text-red-500 border-red-500/30' },
    feature:  { icon: '💡', label: 'Feature',  cls: 'bg-yellow-500/10 text-yellow-500 border-yellow-500/30' },
    feedback: { icon: '💬', label: 'Feedback', cls: 'bg-blue-500/10 text-blue-500 border-blue-500/30' },
    docs:     { icon: '📖', label: 'Docs',     cls: 'bg-purple-500/10 text-purple-500 border-purple-500/30' }
  };
  const STATUS = {
    published: { label: 'Published', cls: 'bg-green-500/10 text-green-500 border-green-500/30' },
    pending:   { label: 'Pending',   cls: 'bg-yellow-500/10 text-yellow-500 border-yellow-500/30' },
    accepted:  { label: 'Accepted',  cls: 'bg-blue-500/10 text-blue-500 border-blue-500/30' },
    shipped:   { label: 'Shipped',   cls: 'bg-purple-500/10 text-purple-500 border-purple-500/30' }
  };

  const INITIAL = 6;
  const PAGE_SIZE = 12;

  let allItems = [];
  let visibleCount = INITIAL;

  function esc(s) { const d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }

  function relTime(ts) {
    if (!ts) return '';
    const sec = Math.floor((Date.now() - ts) / 1000);
    if (sec < 60) return 'just now';
    if (sec < 3600) return Math.floor(sec / 60) + 'm ago';
    if (sec < 86400) return Math.floor(sec / 3600) + 'h ago';
    if (sec < 2592000) return Math.floor(sec / 86400) + 'd ago';
    return new Date(ts).toLocaleDateString();
  }

  function renderCard(c) {
    const tm = TYPE[c.type] || TYPE.feedback;
    const sm = STATUS[c.status] || STATUS.published;
    const msg = c.message || '';
    const preview = msg.length > 120 ? msg.slice(0, 120) + '\u2026' : msg;
    const author = c.username
      ? '<a href="/torcher/' + encodeURIComponent(c.username) + '/" class="hover:text-orange-500 hover:underline font-semibold">' + esc(c.display_name) + '</a>'
      : '<span class="font-semibold">' + esc(c.display_name) + '</span>';

    const details = document.createElement('details');
    details.className = 'group bg-white/5 dark:bg-black/20 backdrop-blur-xl rounded-2xl border border-white/10 overflow-hidden';
    details.innerHTML =
      '<summary class="cursor-pointer p-4 sm:p-5 list-none [&::-webkit-details-marker]:hidden">' +
        '<div class="flex flex-wrap items-center gap-2 mb-2">' +
          '<span class="inline-flex items-center gap-1 text-xs font-bold px-2 py-0.5 rounded-full border ' + tm.cls + '">' + tm.icon + ' ' + tm.label + '</span>' +
          '<span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full border ' + sm.cls + '">' + sm.label + '</span>' +
          (c.tool ? '<span class="text-xs text-gray-500 dark:text-gray-400 px-2 py-0.5 rounded-full bg-white/5 border border-white/10">' + esc(c.tool) + '</span>' : '') +
          '<span class="ml-auto text-xs text-gray-500 dark:text-gray-400">' + relTime(c.created_at) + '</span>' +
        '</div>' +
        (c.subject ? '<h3 class="font-bold text-gray-900 dark:text-gray-100 mb-1">' + esc(c.subject) + '</h3>' : '') +
        '<p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">' + esc(preview) + '</p>' +
        '<div class="mt-2 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">' +
          '<span>by ' + author + '</span>' +
          '<span class="text-orange-500 group-open:hidden">Read more \u25BE</span>' +
          '<span class="text-orange-500 hidden group-open:inline">Show less \u25B4</span>' +
        '</div>' +
      '</summary>' +
      '<div class="px-4 sm:px-5 pb-5 border-t border-white/10 pt-4">' +
        '<div class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed" style="white-space: pre-wrap;">' + esc(msg) + '</div>' +
      '</div>';
    return details;
  }

  function renderVisible() {
    listEl.innerHTML = '';
    const shown = allItems.slice(0, visibleCount);
    if (!shown.length) {
      listEl.innerHTML = '<div class="text-center text-gray-500 dark:text-gray-400 text-sm py-8">No public contributions yet. Submit one above to be the first!</div>';
      if (moreBtn) moreBtn.classList.add('hidden');
      return;
    }
    shown.forEach(function (c) { listEl.appendChild(renderCard(c)); });
    if (moreBtn) {
      const hasMore = visibleCount < allItems.length;
      moreBtn.classList.toggle('hidden', !hasMore);
      moreBtn.textContent = hasMore ? 'Load more contributions \u2192 (' + (allItems.length - visibleCount) + ' remaining)' : '';
    }
  }

  function loadFeed() {
    listEl.innerHTML = '<div class="text-center text-gray-500 dark:text-gray-400 text-sm py-8">Loading\u2026</div>';
    if (moreBtn) moreBtn.classList.add('hidden');
    fetch(WORKER + '/api/contributions/recent?limit=60')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        allItems = (d && d.contributions) || [];
        visibleCount = INITIAL;
        renderVisible();
      })
      .catch(function () {
        listEl.innerHTML = '<div class="text-center text-gray-500 dark:text-gray-400 text-sm py-8">Could not load contributions.</div>';
      });
  }

  if (moreBtn) {
    moreBtn.addEventListener('click', function () {
      visibleCount = Math.min(visibleCount + PAGE_SIZE, allItems.length);
      renderVisible();
    });
  }

  window.addEventListener('tt:contrib-submitted', loadFeed);
  loadFeed();
})();
</script>

