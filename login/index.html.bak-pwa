  <!-- Schema.org -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Login – Traffic Torch",
      "description": "Log in, register, or use a magic link to access your Traffic Torch account. Get Free Pro Lifetime during Beta with code traffictorchpro.",
      "url": "https://traffictorch.net/login/"
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Traffic Torch",
      "url": "https://traffictorch.net/",
      "logo": "https://traffictorch.net/logo-512.webp",
      "description": "Creators of free & pro privacy-first AI-powered SEO and UX analysis tools. Client-side processing – no tracking.",
      "sameAs": [
        "https://g.dev/traffictorch",
        "https://github.com/traffictorch/",
        "https://orcid.org/0009-0006-4084-0241",
        "https://www.wikidata.org/wiki/Q139815165",
        "https://zenodo.org/records/20149616",
        "https://github.com/traffictorch/traffic-torch",
        "https://chromewebstore.google.com/detail/traffic-torch-tools/ngfkdkgjjipecoklnoidfcfidpdafegl",
        "https://addons.mozilla.org/en-US/firefox/addon/traffic-torch-tools/",
        "https://microsoftedge.microsoft.com/addons/detail/traffic-torch-tools/cbbabinigplbmdbnkpkeocchccfalemb",
        "https://marketplace.visualstudio.com/items?itemName=traffic-torch.traffic-torch-dev-tools",
        "https://wordpress.org/plugins/traffic-torch-ai-geo-and-seo-tools/",
